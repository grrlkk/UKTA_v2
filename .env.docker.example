# 프론트엔드
FRONTEND_PORT=3800
REACT_APP_API_URI=http://localhost:8000/api

# 백엔드
BACKEND_PORT=8000
ENV=production
DB_URL=mongodb://ukta:ukta@mongo:27017/ukta?authSource=admin
DB_NAME=ukta
OPENAI_API_KEY=please-set-real-key
OPENAI_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.2

# Bareun 형태소 분석기 (호스트 머신에서 실행 중인 경우)
BAREUN_HOST=host.docker.internal
BAREUN_PORT=5656
BAREUN_API_KEY=please-set-your-bareun-api-key

# MongoDB
MONGO_INITDB_ROOT_USERNAME=ukta
MONGO_INITDB_ROOT_PASSWORD=ukta
MONGO_PORT=27017
